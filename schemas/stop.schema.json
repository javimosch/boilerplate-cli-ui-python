{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Output schema for stop command",
  "properties": {
    "version": {
      "type": "string",
      "description": "Output format version"
    },
    "data": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["stopped"],
          "description": "Daemon status"
        },
        "pid": {
          "type": "integer",
          "description": "Process ID that was stopped"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp"
        }
      },
      "required": ["status", "pid", "timestamp"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of output"
    }
  },
  "required": ["version", "data", "timestamp"]
}