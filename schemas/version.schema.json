{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Output schema for version command",
  "properties": {
    "version": {
      "type": "string",
      "description": "Output format version"
    },
    "data": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Application name"
        },
        "version": {
          "type": "string",
          "description": "Application version"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp"
        }
      },
      "required": ["name", "version", "timestamp"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of output"
    }
  },
  "required": ["version", "data", "timestamp"]
}